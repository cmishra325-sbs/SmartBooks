{
  "name": "smartbooks",
  "version": "1.0.0",
  "description": "SmartBooks AI-Assisted ERP B2B SaaS Platform",
  "main": "backend/dist/index.js",
  "scripts": {
    "dev:backend": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "lint": "eslint \"backend/src/**/*.ts\" \"frontend/src/**/*.ts*\"",
    "test": "jest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dep-cruise": "dependency-cruiser backend/src"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
